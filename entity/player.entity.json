{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:player",
      "min_engine_version": "1.0.0",
      "materials": {
        "default": "entity_alphatest",
        "cape": "entity_alphatest",
        "animated": "player_animated",
        "spectator": "player_spectator",
        "guns": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/steve",
        "cape": "textures/entity/cape_invisible",
        "awp": "textures/gun/awp"
      },
      "geometry": {
        "default": "geometry.humanoid.custom",
        "cape": "geometry.cape",
        "awp": "geometry.awp",
        "awp_tp": "geometry.awp_tp",
        "taczuniversal10": "geometry.taczuniversal10"
      },
      "scripts": {
        "scale": "0.9375",
        "initialize": [
          "v.is_holding_right = 0.0;",
          "v.is_blinking = 0.0;",
          "v.last_blink_time = 0.0;",
          "v.hand_bob = 0.0;",
          "v.idle_time = 0.0;",
          "v.last_attack_time = 0.0;",
          "v.was_using_item = 0.0;",
          "v.is_using_item = 0.0;",
          "v.shot_bow = 0.0;",
          "v.is_inspecting = 0.0;"
        ],
        "pre_animation": [
          "v.helmet_layer_visible = !query.has_head_gear;",
          "v.leg_layer_visible = 1.0;",
          "v.boot_layer_visible = 1.0;",
          "v.chest_layer_visible = 1.0;",
          "variable.is_third_person = !variable.is_first_person && !variable.map_face_icon;",
          "v.attack_body_rot_y = Math.sin(360 * Math.sqrt(v.attack_time)) * 10.0;",
          "v.tcos0 = math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / v.gliding_speed_value * 57.3;",
          "v.first_person_item_rotation_factor = math.sin((1 - v.attack_time) * 180.0);",
          "v.map_angle = math.clamp(1 - v.player_x_rotation / 45.1, 0.0, 1.0);",
          "v.item_use_duration = query.main_hand_item_use_duration > 0.0 ? (query.main_hand_item_max_duration - (query.main_hand_item_use_duration - query.frame_alpha + 1.0)) : 0.0;",
          "v.item_use_normalized = query.main_hand_item_use_duration / query.main_hand_item_max_duration;",
          "v.awp = (q.get_equipped_item_name == 'bow' || q.get_equipped_item_name(0) == 'bow' || q.get_equipped_item_name(0, 1) == 'bow' || q.get_equipped_item_name('main_hand') == 'bow' || q.is_item_name_any('slot.weapon.mainhand', 0, 'minecraft:bow', 'bow'));",
          "variable.awp = v.awp;",
          "variable.holding_all_guns = v.awp;",
          "v.hand_bob = query.life_time < 0.01 ? 0.0 : v.hand_bob + ((query.is_on_ground && query.is_alive && !variable.holding_all_guns ? math.clamp(math.sqrt(math.pow(query.position_delta(0), 2.0) + math.pow(query.position_delta(2), 2.0)), 0.0, 0.1) : 0.0) - v.hand_bob) * 0.02;",
          "v.idle_time = (v.awp && !v.is_inspecting && query.modified_move_speed < 0.1 && !query.is_sprinting && !query.is_sneaking && variable.attack_time == 0.0 && !query.is_using_item) ? (v.idle_time + query.delta_time) : 0.0;",
          "variable.idle_time = v.idle_time;",
          "v.was_using_item = v.is_using_item;",
          "v.is_using_item = query.is_using_item || (query.main_hand_item_use_duration > 0.0);",
          "v.shot_bow = (v.was_using_item && !v.is_using_item) || (variable.attack_time > 0.0 && v.last_attack_time == 0.0);",
          "v.last_attack_time = variable.attack_time;",
          "variable.shot_bow = v.shot_bow;"
        ],
        "animate": [
          "root",
          "blink",
          {
            "awp_fp": "variable.is_first_person && variable.awp"
          },
          {
            "awp_walk_ac": "variable.is_first_person && variable.awp"
          }
        ]
      },
      "animations": {
        "root": "controller.animation.player.root",
        "base_controller": "controller.animation.player.base",
